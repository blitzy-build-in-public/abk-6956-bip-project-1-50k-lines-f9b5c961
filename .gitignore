# Ignore rules for the Foundry repository.
#
# Foundry writes its report files and artifacts into the directory pytest was
# invoked from, so the run-output rules below are anchored to the repository
# root with a leading slash: a same-named path deeper in the tree, such as a
# report comparison pair under tests/fixtures/, stays committable.

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.python-version

# Build output
dist/
build/
*.whl
*.tar.gz

# Foundry run output: the artifacts tree, the three report files written by
# every run and the record/replay cassette directory.
/artifacts/
/results.json
/junit.xml
/report.html
/cassettes/

# Tool caches and reports
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
coverage.json
coverage.xml
.coverage-*
htmlcov/
*.junit.xml

# Editors and OS
.idea/
.vscode/
.DS_Store

# Committed sources. These must stay in version control, so they are
# re-included explicitly: the run-output rules are anchored today and these
# lines keep that intent true if one is ever unanchored. A directory is
# re-included before its contents, because git cannot re-include a file whose
# parent directory is excluded.
!examples/checkout/cassettes/
!examples/checkout/cassettes/**
!tests/fixtures/cassettes/
!tests/fixtures/cassettes/**
!uv.lock
