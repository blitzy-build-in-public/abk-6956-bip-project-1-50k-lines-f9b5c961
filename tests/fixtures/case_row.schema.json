{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One data row of the Foundry example data set; every value is a string because the csv loader yields strings.",
  "properties": {
    "case_id": {
      "pattern": "^C-[0-9]{3}$",
      "type": "string"
    },
    "currency": {
      "enum": [
        "EUR",
        "GBP",
        "USD"
      ],
      "type": "string"
    },
    "expected_total": {
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "type": "string"
    },
    "quantity": {
      "pattern": "^[1-9][0-9]?$",
      "type": "string"
    },
    "tier": {
      "enum": [
        "bronze",
        "gold",
        "platinum",
        "silver"
      ],
      "type": "string"
    },
    "unit_price": {
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "type": "string"
    }
  },
  "required": [
    "case_id",
    "currency",
    "tier",
    "quantity",
    "unit_price",
    "expected_total"
  ],
  "title": "Foundry example data row",
  "type": "object"
}
