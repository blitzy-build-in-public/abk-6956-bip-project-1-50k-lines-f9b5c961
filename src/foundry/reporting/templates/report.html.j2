<!doctype html>
<!--
  foundry report: the single template of the report that foundry.reporting.html renders, shipped as
  package data beside the renderer. One self-contained document -- header, per-outcome summary
  strip, results table, quarantine list, failure panels and an appended run-error list -- that opens
  offline with no network and is complete without JavaScript: native details/summary is the only
  interaction. Every collection arrives sorted from foundry.reporting.html, so iteration order here
  is fixed and two runs of one suite render identical bytes.
-->
<html lang="en" data-foundry-js>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ ctx.title }} — {{ ctx.run_id }}</title>
    <!--
      Autoescaping is enabled for this whole document, so every value interpolated below -- a node
      id, an outcome, a message, a log line -- is escaped and a node id carrying markup renders as
      text. Only ctx.assets.css and ctx.assets.js pass through the safe filter: both are
      module-owned constants of foundry.reporting.assets, never run data.
    -->
    <style>{{ ctx.assets.css | safe }}</style>
  </head>
  <body>
    <header class="report-header">
      <h1>{{ ctx.title }}</h1>
      <p class="meta">
        <span>run id {{ ctx.run_id }}</span>
        <span>profile={{ ctx.profile }}</span>
        <span>finished_at={{ ctx.finished_at }}</span>
        <span>{{ ctx.total_tests }} tests</span>
      </p>
    </header>
    <main>
      {% if ctx.counts %}
      <section aria-label="outcome counts">
        <ul class="summary">
          {% for c in ctx.counts %}
          <li class="{{ c.css_class }}"><span class="count">{{ c.count }}</span> {{ c.outcome }}</li>
          {% endfor %}
        </ul>
      </section>
      {% endif %}
      {% if ctx.artifacts_disabled %}
      <p class="banner">artifact capture is disabled for this run, so no artifact links are available</p>
      {% endif %}
      {% if ctx.no_tests %}
      <div class="no-tests">
        <strong>no tests collected</strong>
        <p>profile={{ ctx.profile }}, run {{ ctx.run_id }}</p>
      </div>
      {% else %}
      <div class="table-scroll">
        <table class="results">
          <caption>test results, one row per test, sorted by node id</caption>
          <thead>
            <tr>
              <th scope="col">test</th>
              <th scope="col">outcome</th>
              <th scope="col">duration</th>
              <th scope="col">profile</th>
              <th scope="col">markers</th>
            </tr>
          </thead>
          <tbody>
            {% for row in ctx.rows %}
            <tr>
              <th scope="row" class="nodeid">{{ row.nodeid }}</th>
              <td><span class="outcome {{ row.css_class }}">{{ row.outcome_value }}</span></td>
              <td class="num">{{ row.duration_display }}</td>
              <td>{{ row.profile }}</td>
              <td>{{ row.markers | join(', ') if row.markers else '—' }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}
      {% if ctx.quarantined %}
      <section class="quarantined" aria-labelledby="quarantined-heading">
        <h2 id="quarantined-heading">Quarantined</h2>
        <ul>
          {% for q in ctx.quarantined %}
          <li>
            <code>{{ q.nodeid }}</code>
            <span class="outcome {{ q.css_class }}">{{ q.outcome }}</span>
            {% if q.note %}
            <p class="note">{{ q.note }}</p>
            {% endif %}
          </li>
          {% endfor %}
        </ul>
      </section>
      {% endif %}
      {% for panel in ctx.panels %}
      <details class="panel"{% if loop.first %} open{% endif %}>
        <summary>{{ panel.nodeid }}: {{ panel.outcome }} ({{ panel.phase }})</summary>
        <p>{{ panel.message }}</p>
        {% if panel.has_links %}
        {# Each *_path is a relative filesystem path whose node-id segment is percent-escaped by
           the artifact-name sanitiser; doubling the percent sign is the one encoding level that
           turns such a path into a relative URL a browser opens, keeping the path scheme-free.
           The traceback stays plain text rather than a third link: a person opens the two dumps,
           and the traceback path is enough to find the file. #}
        <dl>
          {% if panel.request_path %}
          <dt>request</dt>
          <dd><a href="{{ panel.request_path | replace('%', '%25') }}">request dump</a></dd>
          {% endif %}
          {% if panel.response_path %}
          <dt>response</dt>
          <dd><a href="{{ panel.response_path | replace('%', '%25') }}">response dump</a></dd>
          {% endif %}
          {% if panel.traceback_path %}
          <dt>traceback</dt>
          <dd><code>{{ panel.traceback_path }}</code></dd>
          {% endif %}
        </dl>
        {% endif %}
        {# A tail that was read but held no lines is not the same as a tail that could not be read,
           and an empty monospace block would read as a rendering fault. #}
        {% if panel.has_log %}
        <pre class="log">{{ panel.log_lines | join('\n') }}</pre>
        {% elif panel.log_available %}
        <p>log tail captured no lines</p>
        {% else %}
        <p>log tail unavailable</p>
        {% endif %}
      </details>
      {% endfor %}
      {% if ctx.errors %}
      <section aria-labelledby="errors-heading">
        <h2 id="errors-heading">Errors</h2>
        <ul>
          {% for error in ctx.errors %}
          <li><code>{{ error.worker_id }}</code> {{ error.message }}</li>
          {% endfor %}
        </ul>
      </section>
      {% endif %}
    </main>
    <footer class="report-footer">
      <p>foundry report. This file is self-contained: open it offline, it fetches nothing.</p>
    </footer>
    <script>{{ ctx.assets.js | safe }}</script>
  </body>
</html>
